 },
 {
  "id": "3b",
  "start": 11.419,
  "dur": 0.59,
  "text": "إِثْبَات، فَاتُورَة، وِمَوْعِد."
 },
 {
  "id": "3c",
  "start": 12.149,
  "dur": 0.81,
  "text": "إِثْبَات، فَاتُورَة، وِمَوْعِد."
 },
 {
  "id": "3d",
  "start": 13.099,
  "dur": 0.819,
  "text": "إِثْبَات، فَاتُورَة، وِمَوْعِد."
 },
 {
  "id": "3e",
  "start": 14.059,
  "dur": 3.805,
  "text": "التَّوْسِيقِ الصَّحّ، بِيِحْمِي مَشْرُوعَكْ مِنِ الْغَرَامَاتْ."
 },
 {
  "id": "4",
  "start": 18.004,
  "dur": 2.258,
  "text": "وِهَاي تْلَات نُقَاط بِتِحْمِيك."
 },
 {
  "id": "5a",
  "start": 21.284,
  "dur": 2.067,
  "text": "أَوَّلًا: الْفَاتُورَة الرَّسْمِيَّة."
 },
 {
  "id": "5b",
  "start": 23.491,
  "dur": 3.816,
  "text": "لَازِمْ يْكُونْ عَلَيْهَا اسِمِ الْمُنْشَأَة وِالرَّقَمِ الضَّرِيبِي،"
 },
 {
  "id": "5c",
  "start": 27.447,
  "dur": 2.216,
  "text": "وِالتَّارِيخْ وِرَقَمْ تَسَلْسُلِي."
