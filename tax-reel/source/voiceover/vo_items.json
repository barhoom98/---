 {
  "id": "6a",
  "start": 31.916,
  "dur": 3.704,
  "text": "ثَانِيًا: الْمَصْرُوفْ لَازِمْ يْكُونْ مِرْتِبِطْ بِشُغْلَكْ"
 },
 {
  "id": "6b",
  "start": 35.759,
  "dur": 1.203,
  "text": "وِمْوَسَّقْ بِفَاتُورَة."
 },
 {
  "id": "6c",
  "start": 37.102,
  "dur": 2.274,
  "text": "أَمَّا الشَّخْصِي، مَا بِيِنْخِصِمْ."
 },
 {
  "id": "7a",
  "start": 39.802,
  "dur": 1.54,
  "text": "ثَالِثًا: الْمَوَاعِيدْ."
 },
 {
  "id": "7b",
  "start": 42.622,
  "dur": 1.533,
