 },
 {
  "id": "7c",
  "start": 44.294,
  "dur": 1.722,
  "text": "وِجَهِّز أَرْقَامَك بَدْرِي،"
 },
 {
  "id": "7d",
  "start": 46.156,
  "dur": 2.329,
  "text": "لِأَنُّه التَّأْخِيرْ مَعْنَاه غَرَامَة."
 },
 {
  "id": "8a",
  "start": 48.625,
  "dur": 2.037,
  "text": "الْخُلَاصَة: فَاتُورَة رَسْمِيَّة،"
 },
 {
  "id": "8c",
  "start": 50.802,
  "dur": 1.176,
  "text": "تَوْسِيقْ مُنَظَّمْ،"
 },
 {
  "id": "8d",
  "start": 52.118,
  "dur": 1.609,
  "text": "وِالْتِزَامْ بِالْمَوْعِدْ."
 },
 {
  "id": "9",
  "start": 53.866,
  "dur": 3.668,
  "text": "إِشْعَارْ وَاحِدْ مُمْكِنْ يْوَفِّرْ عَلَيْكْ غَرَامَة كَامْلَة."
 },
 {
  "id": "10a",
  "start": 58.016,
  "dur": 3.586,
  "text": "بِدَّك تِعْرَف كِيف تِحْسِب ضَرِيبْتَك بِخَمِس دِقَايِق؟"
 },
 {
  "id": "10b",
  "start": 61.742,
  "dur": 1.859,
  "text": "اكْتُب «ضَرِيبَة» بِالتَّعْلِيقَات."
 }
