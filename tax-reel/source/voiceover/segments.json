[
 {
  "id": "1",
  "a": 0.1,
  "w": null,
  "text": "مِشْ كُلّ مَصْرُوفْ بِيِنْخِصِمْ ضَرِيبِيًّا!"
 },
 {
  "id": "2a",
  "a": 3.0,
  "w": [
   1.7,
   2.55
  ],
  "text": "كْتِيرْ بِيِدْفَعُوا وِبِيِحْسِبُوهَا مَصْرُوفْ…"
 },
 {
  "id": "2b",
  "a": 4.35,
  "w": [
   3.95,
   4.3
  ],
  "text": "بَسّ مُمْكِنْ تِنْرِفِضْ."
 },
 {
  "id": "3a",
  "a": 6.9,
  "w": [
   5.3,
   6.4
  ],
  "text": "الْفَرْقْ بَيْنِ الْمَقْبُولْ وِالْمَرْفُوضْ:"
 },
 {
  "id": "3bcd",
  "a": 9.74,
  "w": [
   7.4,
   9.25
  ],
  "sub": [
   9.74,
   10.08,
   10.44
  ],
  "subw": [
   null,
   [
    9.86,
    10.04
   ],
   [
    10.22,
    10.42
   ]
  ],
  "text": "إِثْبَاتْ، فَاتُورَة، وِمَوْعِدْ."
 },
 {
  "id": "3e",
  "a": 10.9,
  "w": [
   10.6,
   10.88
  ],
  "text": "التَّوْثِيقِ الصَّحّ بِيِحْمِي مَشْرُوعَكْ مِنِ الْغَرَامَاتْ."
 },
 {
  "id": "4",
  "a": 12.62,
  "w": [
   11.6,
   12.15
  ],
  "text": "وِهَايْ تْلَاتْ نُقَاطْ بِتِحْمِيكْ."
 },
 {
  "id": "5a",
  "a": 15.9,
  "w": [
   14.75,
   15.25
  ],
  "text": "أَوَّلًا: الْفَاتُورَة الرَّسْمِيَّة."
 },
 {
  "id": "5b",
  "a": 17.85,
  "w": [
   16.95,
   17.22
  ],
  "text": "لَازِمْ يْكُونْ عَلَيْهَا اسِمِ الْمُنْشَأَة وِالرَّقَمِ الضَّرِيبِي،"
 },
 {
  "id": "5c",
  "a": 19.45,
  "w": [
   18.4,
   19.0
  ],
  "text": "وِالتَّارِيخْ وِرَقَمْ تَسَلْسُلِي."
 },
 {
  "id": "5d",
  "a": 21.0,
  "w": [
   20.0,
   20.55
  ],
  "text": "وِدَايْمًا احْتَفِظْ بِالْأَصِلْ."
 },
 {
  "id": "6a",
  "a": 22.4,
  "w": [
   21.45,
   21.85
  ],
  "text": "ثَانِيًا: الْمَصْرُوفْ لَازِمْ يْكُونْ مِرْتِبِطْ بِشُغْلَكْ"
 },
 {
  "id": "6b",
  "a": 24.95,
  "w": [
   23.2,
   23.7
  ],
  "text": "وِمُوَثَّقْ بِفَاتُورَة."
 },
 {
  "id": "6c",
  "a": 26.1,
  "w": [
   25.45,
   26.0
  ],
  "text": "أَمَّا الشَّخْصِي؟ مَا بِيِنْخِصِمْ."
 },
 {
  "id": "7a",
  "a": 28.8,
  "w": [
   27.4,
   28.25
  ],
  "text": "ثَالِثًا: الْمَوَاعِيدْ."
 },
 {
  "id": "7b",
  "a": 31.62,
  "w": [
   29.55,
   30.0
  ],
  "text": "سَجِّلْ مَوْعِدِ الْإِقْرَارْ،"
 },
 {
  "id": "7c",
  "a": 32.52,
  "w": [
   32.0,
   32.45
  ],
  "text": "وِجَهِّزْ أَرْقَامَكْ بَدْرِي،"
 },
 {
  "id": "7d",
  "a": 33.32,
  "w": [
   32.95,
   33.25
  ],
  "text": "لِأَنُّه التَّأْخِيرْ مَعْنَاه غَرَامَة."
 },
 {
  "id": "8a",
  "a": 34.6,
  "w": [
   33.8,
   34.4
  ],
  "text": "الْخُلَاصَة: فَاتُورَة رَسْمِيَّة،"
 },
 {
  "id": "8c",
  "a": 35.92,
  "w": [
   35.4,
   35.76
  ],
  "text": "تَوْثِيقْ مُنَظَّمْ،"
 },
 {
  "id": "8d",
  "a": 36.79,
  "w": [
   36.3,
   36.64
  ],
  "text": "وِالْتِزَامْ بِالْمَوْعِدْ."
 },
 {
  "id": "9",
  "a": 37.75,
  "w": [
   37.0,
   37.55
  ],
  "text": "إِشْعَارْ وَاحِدْ مُمْكِنْ يْوَفِّرْ عَلَيْكْ غَرَامَة كَامْلَة."
 },
 {
  "id": "10a",
  "a": 41.9,
  "w": [
   39.95,
   40.8
  ],
  "text": "بِدَّكْ تِعْرَفْ كِيفْ تِحْسِبْ ضَرِيبْتَكْ بِخَمِسْ دْقَايِقْ؟"
 },
 {
  "id": "10b",
  "a": 43.6,
  "w": [
   42.95,
   43.5
  ],
  "text": "اكْتُبْ «ضَرِيبَة» بِالتَّعْلِيقَاتْ."
 }
]